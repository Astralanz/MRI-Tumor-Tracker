        self.btn_download.setStyleSheet("QPushButton { background-color: #f33b3b; color: white; font-weight: bold; border-radius: 22px; border: none; } QPushButton:hover { background-color: #cf2a2a; } QPushButton:disabled { background-color: #f79999; }")
        self.btn_download.clicked.connect(self.download_gambar) # Jika diklik, jalankan fungsi download_gambar

        panel_tombol.addWidget(btn_upload)
        panel_tombol.addWidget(self.btn_download)

        baris_bawah.addLayout(panel_slider, stretch=1)
        baris_bawah.addWidget(self.panel_final, stretch=1, alignment=Qt.AlignCenter)
        baris_bawah.addLayout(panel_tombol, stretch=1)

        konten_kanan.addLayout(baris_bawah)
        konten_kanan.addStretch(1) 
        layout_utama.addLayout(konten_kanan)

    # Fungsi bantuan GUI: Mendesain kotak panel untuk menaruh gambar
    def buat_panel_gambar(self, title, size):
        panel = QWidget()
        layout = QVBoxLayout(panel)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(10)
        layout.setAlignment(Qt.AlignCenter)
        
        lbl_title = QLabel(title)
        lbl_title.setAlignment(Qt.AlignCenter)
        lbl_title.setFixedHeight(35)
        lbl_title.setStyleSheet("background-color: #3b6af3; color: white; font-weight: bold; border-radius: 17px;")
        
        lbl_img = QLabel()
        lbl_img.setAlignment(Qt.AlignCenter)
        lbl_img.setFixedSize(size, size)
        lbl_img.setStyleSheet("background-color: white; border: 2px solid #ccc; border-radius: 15px;")
        
        layout.addWidget(lbl_title)
        layout.addWidget(lbl_img)
        return panel, lbl_img

    # Fungsi bantuan GUI: Mendesain slider dan label teksnya
    def buat_slider_ui(self, nama, min_val, max_val, default_val):
        layout = QVBoxLayout()
        layout.setSpacing(5)
        
        lbl = QLabel(f"{nama}{default_val}")
        lbl.setStyleSheet("color: #444; font-weight: bold; font-size: 13px; border: none;")
        
        slider = QSlider(Qt.Horizontal)
        slider.setMinimum(min_val)
        slider.setMaximum(max_val)
        slider.setValue(default_val)
        slider.setStyleSheet("QSlider::groove:horizontal { border: none; height: 6px; background: #ccc; border-radius: 3px; } QSlider::handle:horizontal { background: #3b6af3; width: 18px; height: 18px; margin: -6px 0; border-radius: 9px; }")
        
        # Trigger: Jika slider digeser lalu dilepas, ulangi proses gambar dari awal
        slider.sliderReleased.connect(self.proses_gambar)
        slider.valueChanged.connect(lambda val, l=lbl, n=nama: l.setText(f"{n}{val}"))
        
        layout.addWidget(lbl)
        layout.addWidget(slider)
        return layout, slider

    # Fungsi GUI: Membuka jendela Windows Explorer untuk memilih file MRI
    def upload_gambar(self):
        file_name, _ = QFileDialog.getOpenFileName(self, "Buka Citra MRI", "", "Image Files (*.png *.jpg *.jpeg)")
        if file_name:
            self.img_bgr = cv2.imread(file_name)
            if self.img_bgr is not None:
                self.btn_download.setEnabled(True)
                self.proses_gambar() # Langsung deteksi setelah upload
            else:
                QMessageBox.warning(self, "Error", "Gagal memuat gambar!")

    # Fungsi GUI: Menyimpan hasil deteksi final ke komputer user
    def download_gambar(self):
        if self.final_result_img is None:
            return
        path, _ = QFileDialog.getSaveFileName(self, "Simpan Hasil Deteksi", "hasil_tumor_final.jpg", "JPEG (*.jpg);;PNG (*.png)")
        if path:
            cv2.imwrite(path, self.final_result_img)
            QMessageBox.information(self, "Sukses", f"Gambar berhasil disimpan di:\n{path}")

    # Fungsi Jembatan: OpenCV menggunakan format array (CV2), sedangkan GUI butuh format Pixmap (Qt). 
    # Fungsi ini menerjemahkan gambar dari format mesin ke format tampilan layar.
    def cv2_ke_qpixmap(self, cv_img, target_label):
        if len(cv_img.shape) == 2:
            h, w = cv_img.shape
            bytes_per_line = w
            qt_img = QImage(cv_img.data, w, h, bytes_per_line, QImage.Format_Grayscale8)
        else:
            h, w, ch = cv_img.shape
            bytes_per_line = ch * w
            qt_img = QImage(cv_img.data, w, h, bytes_per_line, QImage.Format_RGB888)
        
        return QPixmap.fromImage(qt_img).scaled(target_label.width(), target_label.height(), Qt.KeepAspectRatio)

# ==============================================================================
# BLOK 2: ALGORITMA PEMROSESAN CITRA (OPENCV)
# Di sinilah inti program lu bekerja. Tahapan ini yang dievaluasi pas asistensi.
# ==============================================================================

    def proses_gambar(self):
        if self.img_bgr is None:
            return

        # Mengambil nilai angka secara real-time dari posisi slider yang sedang digeser user
        val_thresh = self.lbl_val_th.value()
        val_circ   = self.lbl_val_circ.value() / 100.0
        val_area   = self.lbl_val_area.value()

        # ---------------------------------------------------------
        # TAHAP 1: PRE-PROCESSING (KONVERSI & AUTO-CROP)
        # ---------------------------------------------------------
        # Mengubah gambar menjadi RGB untuk tampilan, dan Grayscale untuk proses deteksi
        img_rgb  = cv2.cvtColor(self.img_bgr, cv2.COLOR_BGR2RGB)
        img_gray = cv2.cvtColor(self.img_bgr, cv2.COLOR_BGR2GRAY)
        
        # Mengirim gambar asli ke Panel 1 di GUI
        self.lbl_asli.setPixmap(self.cv2_ke_qpixmap(img_rgb, self.lbl_asli))

        # Algoritma Auto-Crop: Mencari batas piksel yang bukan warna putih polos
        # Tujuannya membuang area kosong di pinggiran hasil scan MRI
        not_white = img_gray < 254
        rows = np.any(not_white, axis=1)
        cols = np.any(not_white, axis=0)
        if rows.any() and cols.any():
            rmin, rmax = np.where(rows)[0][[0, -1]]
            cmin, cmax = np.where(cols)[0][[0, -1]]
            mri_rgb  = img_rgb[rmin:rmax, cmin:cmax]
            mri_gray = img_gray[rmin:rmax, cmin:cmax].copy()
            mri_gray[mri_gray > 253] = 0   
        else:
            mri_rgb  = img_rgb
            mri_gray = img_gray.copy()
        h, w = mri_gray.shape

        # ---------------------------------------------------------
        # TAHAP 2: SKULL STRIPPING (PENGHAPUSAN TENGKORAK)
        # ---------------------------------------------------------
        # Menggunakan operasi Morfologi Matematika untuk mengikis tulang kepala
        _, head_mask = cv2.threshold(mri_gray, 15, 255, cv2.THRESH_BINARY)
        kernel_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15,15))
        closed_head  = cv2.morphologyEx(head_mask, cv2.MORPH_CLOSE, kernel_close)
        
        kernel_clean = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5,5))
        cleaned_head = cv2.morphologyEx(closed_head, cv2.MORPH_OPEN, kernel_clean)
        
        # Erosi agresif: Mengikis lapisan luar menggunakan kernel elips ukuran 25x25
        kernel_agg   = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (25,25))
        mask_pedoman = cv2.erode(cleaned_head, kernel_agg, iterations=1)
        
        # Menggabungkan gambar asli dengan mask erosi, menyisakan jaringan otak saja
        brain_only = cv2.bitwise_and(mri_gray, mask_pedoman)

        # ---------------------------------------------------------
        # TAHAP 3: IMAGE ENHANCEMENT (PERBAIKAN KONTRAS)
        # ---------------------------------------------------------
        # CLAHE: Meratakan kontras cahaya agar jaringan tumor (putih) lebih menonjol
        clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))
        brain_enhanced = clahe.apply(brain_only)
        
        # Bilateral Filter: Menghaluskan bintik kasar (noise) namun tetap menjaga ketajaman tepi objek
        blurred_brain  = cv2.bilateralFilter(brain_enhanced, 7, 50, 50)
        
        # Mengirim hasil otak bersih dan kontras tinggi ke Panel 2 di GUI
        self.lbl_clahe.setPixmap(self.cv2_ke_qpixmap(blurred_brain, self.lbl_clahe))

        # ---------------------------------------------------------
        # TAHAP 4: SEGMENTASI (PENCARIAN KANDIDAT BENTUK)
        # ---------------------------------------------------------
        brain_pixels = blurred_brain[blurred_brain > 15]
        if len(brain_pixels) > 0:
            # Jika slider Batas Kecerahan di angka 0 -> Gunakan Otsu Thresholding Otomatis
            if val_thresh == 0:
                thresh_val, _ = cv2.threshold(brain_pixels, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
                _, thresh = cv2.threshold(blurred_brain, thresh_val, 255, cv2.THRESH_BINARY)
            # Jika slider digeser -> Gunakan Global Thresholding (Batas Manual dari User)
            else:
                _, thresh = cv2.threshold(blurred_brain, val_thresh, 255, cv2.THRESH_BINARY)
        else:
            thresh = np.zeros_like(blurred_brain)

        # Membersihkan sisa-sisa bercak cacat setelah proses pemotongan Threshold
        kernel_morph = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7,7))
        thresh_closed = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, kernel_morph)
        thresh_closed = cv2.morphologyEx(thresh_closed, cv2.MORPH_OPEN, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3,3)))
        
        # Mencari dan mengekstrak semua garis tepi kontur (pulau-pulau putih) dari gambar biner
        contours, _ = cv2.findContours(thresh_closed, cv2.RETR_LIST, cv2.CHAIN_APPROX_SIMPLE)

        # ---------------------------------------------------------
        # TAHAP 5: FEATURE EXTRACTION (PENYARINGAN FITUR GEOMETRI)
        # ---------------------------------------------------------
        valid = []
        # Mengecek semua kandidat kontur satu per satu
        for cnt in contours:
            # Filter 1: Cek luas piksel (Luas harus di antara nilai Slider Minimum dan 50.000)
            area = cv2.contourArea(cnt)
            if area < val_area or area > 50000:
                continue
            
            # Filter 2: Cek rumus Sirkularitas/Kebulatan (Bentuk tidak boleh lebih melenceng dari nilai Slider Kebulatan)
            peri = cv2.arcLength(cnt, True)
            if peri == 0:
                continue
            circ = 4 * np.pi * area / (peri ** 2)
            if circ < val_circ:
                continue
            
            # Cek pusat koordinat: Memastikan kontur tidak berada persis menempel di tepi luar gambar (biasanya itu sisa tulang, bukan tumor)
            (cx, cy), r = cv2.minEnclosingCircle(cnt)
            if cx < 10 or cx > w - 10 or cy < 10 or cy > h - 10:
                continue
            
            # Jika lolos semua ujian di atas, simpan sebagai 'Tumor Valid'
            valid.append((cnt, area, circ, int(cx), int(cy), int(r)))

        # ---------------------------------------------------------
        # TAHAP 6: MENGGAMBAR MULTI-TUMOR & PENOMORAN KE LAYAR GUI
        # ---------------------------------------------------------
        # Menyiapkan kanvas kosong untuk digambar
        thresh_rgb = cv2.cvtColor(thresh_closed, cv2.COLOR_GRAY2RGB)
        final_img = mri_rgb.copy()

        # Skenario Gagal: Jika tidak ada satupun kontur putih yang lolos ujian (List valid kosong)
        if not valid:
            self.lbl_kandidat.clear()
            self.lbl_kandidat.setText("Tumor Tidak Ditemukan\n(Geser Slider)")
            self.lbl_final.clear()
            self.lbl_final.setText("Gagal")
            self.final_result_img = cv2.cvtColor(mri_rgb, cv2.COLOR_RGB2BGR)
            return

        # Skenario Berhasil: Looping untuk menggambar seluruh tumor yang ditemukan
        for idx, item in enumerate(valid, 1):
            cnt, area, circ, cx, cy, r = item
            
            # Menggambar kontur merah dan lingkaran penutup hijau di Panel 3
            cv2.drawContours(thresh_rgb, [cnt], -1, (255, 0, 0), 2)
            cv2.circle(thresh_rgb, (cx, cy), r, (0, 255, 0), 2)
            
            # Menggambar outline tebal warna biru di Panel 4 (Hasil Final)
            cv2.drawContours(final_img, [cnt], -1, (0, 0, 255), 3) 
            
            # Mencetak teks angka (Nomor urut kuning) tepat di samping posisi tumor
            cv2.putText(final_img, str(idx), (cx + 55, cy + 10), 
                        cv2.FONT_HERSHEY_SIMPLEX, 0.9, (255, 255, 0), 2, cv2.LINE_AA)

        # Mengirim gambar yang sudah dilukis ke GUI
        self.lbl_kandidat.setPixmap(self.cv2_ke_qpixmap(thresh_rgb, self.lbl_kandidat))
        self.lbl_final.setPixmap(self.cv2_ke_qpixmap(final_img, self.lbl_final))
        
        # Menyimpan format BGR untuk fungsi Download agar nomor dan garis ikut ter-download
        self.final_result_img = cv2.cvtColor(final_img, cv2.COLOR_RGB2BGR)

if __name__ == '__main__':
    app = QApplication(sys.argv)
    
    # Pengaturan agar seluruh teks di aplikasi menggunakan font modern Poppins
    app.setFont(QFont("Poppins", 10))
    
    window = DeteksiTumorApp()
    window.show()
    sys.exit(app.exec_())