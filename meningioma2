        layout_utama = QHBoxLayout(main_widget)
        layout_utama.setContentsMargins(20, 20, 20, 20)
        layout_utama.setSpacing(20)

        # ---------------------------------------------------------
        # BAGIAN GUI: SIDEBAR KIRI (MENU)
        # ---------------------------------------------------------
